# Copy to .env and replace every value before running `docker compose up`.
# .env is git-ignored; never commit real credentials.

# TimescaleDB (docker-compose service: timescaledb)
POSTGRES_USER=triton
POSTGRES_PASSWORD=change-me
POSTGRES_DB=triton_telemetry

# Grafana (docker-compose service: grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
